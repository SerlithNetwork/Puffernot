     @Override
     protected void tick(final ServerLevel level, final Villager body, final long timestamp) {
-        if (timestamp % 100L == 0L) {
+        // Pufferfish start
+        if (body.pufferfish$nextGolemPanic < 0) body.pufferfish$nextGolemPanic = timestamp + 100;
+        if (--body.pufferfish$nextGolemPanic < timestamp) {
+            body.pufferfish$nextGolemPanic = -1;
+            // Pufferfish end
             body.spawnGolemIfNeeded(level, timestamp, 3);
         }
     }
