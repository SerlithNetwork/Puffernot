diff --git a/net/minecraft/world/entity/ambient/Bat.java b/net/minecraft/world/entity/ambient/Bat.java
index c0198c0b6d00667c9591a5cd254b0bfedc3fb627..177944bf79ddec4cb94b4bd2268ad4af72662b4c 100644
--- a/net/minecraft/world/entity/ambient/Bat.java
+++ b/net/minecraft/world/entity/ambient/Bat.java
@@ -246,11 +246,19 @@ public class Bat extends AmbientCreature {
         }
     }
 
+    // Pufferfish start - only check for spooky season once an hour
+    private static boolean pufferfish$isSpookySeason = false;
+    private static final int PUFFERFISH$ONE_HOUR = 20 * 60 * 60;
+    private static int pufferfish$lastSpookyCheck = -PUFFERFISH$ONE_HOUR;
     private static boolean isHalloween() {
+        if (net.minecraft.server.MinecraftServer.currentTick - pufferfish$lastSpookyCheck > PUFFERFISH$ONE_HOUR) {
         LocalDate localDate = LocalDate.now();
         int i = localDate.get(ChronoField.DAY_OF_MONTH);
         int i1 = localDate.get(ChronoField.MONTH_OF_YEAR);
-        return i1 == 10 && i >= 20 || i1 == 11 && i <= 3;
+        pufferfish$isSpookySeason = i1 == 10 && i >= 20 || i1 == 11 && i <= 3;
+        pufferfish$lastSpookyCheck = net.minecraft.server.MinecraftServer.currentTick;
+        }
+        return pufferfish$isSpookySeason;
     }
 
     private void setupAnimationStates() {
