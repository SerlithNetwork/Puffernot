diff --git a/net/minecraft/world/entity/projectile/Projectile.java b/net/minecraft/world/entity/projectile/Projectile.java
index 089dd82e6806f4f1fbff554058dc44f15593e37f..1703a617699eaaad99d081355b1314faef9333da 100644
--- a/net/minecraft/world/entity/projectile/Projectile.java
+++ b/net/minecraft/world/entity/projectile/Projectile.java
@@ -61,6 +61,36 @@ public abstract class Projectile extends Entity implements TraceableEntity {
         super(type, level);
     }
 
+    // Pufferfish start - Reduce Projectile Chunk Loading
+    private static int PUFFERFISH$LOADED_THIS_TICK = 0;
+    private static int PUFFERFISH$LOADED_TICK;
+
+    private int pufferfish$loadedLifetime = 0;
+    @Override
+    public void setPos(final double x, final double y, final double z) {
+        int currentTick = net.minecraft.server.MinecraftServer.currentTick;
+        if (Projectile.PUFFERFISH$LOADED_TICK != currentTick) {
+            Projectile.PUFFERFISH$LOADED_TICK = currentTick;
+            Projectile.PUFFERFISH$LOADED_THIS_TICK = 0;
+        }
+        int previousX = Mth.floor(this.getX()) >> 4, previousZ = Mth.floor(this.getZ()) >> 4;
+        int newX = Mth.floor(x) >> 4, newZ = Mth.floor(z) >> 4;
+        if (previousX != newX || previousZ != newZ) {
+            boolean isLoaded = ((net.minecraft.server.level.ServerChunkCache) this.level().getChunkSource()).getChunkAtIfLoadedImmediately(newX, newZ) != null;
+            if (!isLoaded) {
+                if (Projectile.PUFFERFISH$LOADED_THIS_TICK > gg.pufferfish.pufferfish.PufferfishConfig.getInstance().projectile.maxLoadsPerTick) {
+                    if (++this.pufferfish$loadedLifetime > gg.pufferfish.pufferfish.PufferfishConfig.getInstance().projectile.maxLoadsPerProjectile) {
+                        this.discard(org.bukkit.event.entity.EntityRemoveEvent.Cause.DESPAWN);
+                    }
+                    return;
+                }
+                Projectile.PUFFERFISH$LOADED_THIS_TICK++;
+            }
+        }
+        super.setPos(x, y, z);
+    }
+    // Pufferfish end - Reduce Projectile Chunk Loading
+
     @Override
     protected void applyImplicitComponents(final DataComponentGetter components) {
         this.applyImplicitComponentIfPresent(components, DataComponents.CAN_BREAK);
