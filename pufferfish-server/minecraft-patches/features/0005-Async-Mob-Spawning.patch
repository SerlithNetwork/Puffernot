+            if (pufferfish$firstRunSpawnCounts) {
+                pufferfish$firstRunSpawnCounts = false;
+                pufferfish$spawnCountsReady.set(true);
+            }
+            if (pufferfish$spawnCountsReady.getAndSet(false)) {
+                net.minecraft.server.MinecraftServer.getServer().pufferfish$mobSpawnExecutor.submit(() -> {
