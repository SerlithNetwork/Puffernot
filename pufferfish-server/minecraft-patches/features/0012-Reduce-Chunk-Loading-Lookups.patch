diff --git a/net/minecraft/world/entity/LivingEntity.java b/net/minecraft/world/entity/LivingEntity.java
index 6a5883744f399931c4c37963a5569846e23324c1..1ccfa1cad3f54d61d4501975d3f59331ae41fa2a 100644
--- a/net/minecraft/world/entity/LivingEntity.java
+++ b/net/minecraft/world/entity/LivingEntity.java
@@ -4542,10 +4542,13 @@ public abstract class LivingEntity extends Entity implements Attackable, Waypoin
         WorldBorder worldBorder = level.getWorldBorder();
         Vec3 clamped = worldBorder.clampVec3ToBound(xx, y, zz);
         BlockPos.MutableBlockPos pos = BlockPos.containing(clamped).mutable();
-        if (level.hasChunkAt(pos)) {
+        // Pufferfish start - single chunk lookup
+        net.minecraft.world.level.chunk.LevelChunk pufferfish$chunk = level.getChunkIfLoaded(pos);
+        if (pufferfish$chunk != null) {
+        // Pufferfish stop - single chunk lookup
             while (pos.getY() > level.getMinY()) {
                 pos.move(Direction.DOWN);
-                BlockState state = level.getBlockState(pos);
+                BlockState state = pufferfish$chunk.getBlockState(pos); // Pufferfish - single chunk lookup
                 if (state.is(BlockTags.ENTITIES_CAN_TELEPORT_TO)) {
                     return this.checkPositionAndTeleport(clamped.x, y, clamped.z, showParticles, isInvalidPosition, state, level, cause); // Paper - teleport cause API
                 }
