Subject: [PATCH] Cache Climbing Check


diff --git a/io/papermc/paper/entity/activation/ActivationRange.java b/io/papermc/paper/entity/activation/ActivationRange.java
index bc1317b08c8657f2c045940f2c14e4f251dece0c..4728a672c6caa7727cb992f1976a7a828cbffd7a 100644
--- a/io/papermc/paper/entity/activation/ActivationRange.java
+++ b/io/papermc/paper/entity/activation/ActivationRange.java
@@ -239,7 +239,7 @@ public final class ActivationRange {
         }
         // special cases.
         if (entity instanceof final LivingEntity living) {
-            if (living.onClimbable() || living.jumping || living.hurtTime > 0 || !living.activeEffects.isEmpty() || living.isFreezing()) {
+            if (living.pufferfish$onClimbableCached() || living.jumping || living.hurtTime > 0 || !living.activeEffects.isEmpty() || living.isFreezing()) { // Pufferfish - use cached
                 return 1;
             }
             if (entity instanceof final Mob mob && mob.getTarget() != null) {
diff --git a/net/minecraft/world/entity/LivingEntity.java b/net/minecraft/world/entity/LivingEntity.java
index fbf54b8de5e019cbb214b1c766bcf7a81f728fbe..900476c49eeab6a99d34d97aa372b514816687f6 100644
--- a/net/minecraft/world/entity/LivingEntity.java
+++ b/net/minecraft/world/entity/LivingEntity.java
@@ -2170,6 +2170,19 @@ public abstract class LivingEntity extends Entity implements Attackable, Waypoin
         return this.lastClimbablePos;
     }
 
+    // Pufferfish start
+    private boolean pufferfish$cachedOnClimable = false;
+    private BlockPos pufferfish$lastClimbingPosition = null;
+
+    public boolean pufferfish$onClimbableCached() {
+        if (!this.blockPosition().equals(this.pufferfish$lastClimbingPosition)) {
+            this.pufferfish$cachedOnClimable = this.onClimbable();
+            this.pufferfish$lastClimbingPosition = this.blockPosition();
+        }
+        return this.pufferfish$cachedOnClimable;
+    }
+    // Pufferfish end
+
     public boolean onClimbable() {
         if (this.isSpectator()) {
             return false;
